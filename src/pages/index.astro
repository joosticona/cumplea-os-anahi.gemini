---
import Layout from '../layouts/Layout.astro';
import WelcomeOverlay from '../components/WelcomeOverlay.astro';
import MusicToggle from '../components/MusicToggle.astro';
import Badge from '../components/Badge.astro';
import Heading from '../components/Heading.astro';
import Paragraph from '../components/Paragraph.astro';
import Button from '../components/Button.astro';
import CakeStage from '../components/CakeStage.astro';
import MomentCard from '../components/MomentCard.astro';
import LetterSection from '../components/LetterSection.astro';
---

<Layout title="¡Feliz Cumpleaños, mi Anahí! 💙💜">
  <!-- Pantalla de Bienvenida Interactiva -->
  <WelcomeOverlay />

  <!-- Control de Melodía -->
  <MusicToggle />

  <main class="main-container">
    <!-- Encabezado Principal -->
    <section class="hero-section">
      <Badge>💙 Te amo con todo mi corazón 💜</Badge>
      <Heading level={1} class="hero-Script">
        ¡Feliz Cumpleaños, <span class="hero-name">mi Anahí</span>!
      </Heading>
      <Paragraph class="hero-dedication">
        Que este día esté lleno de alegría, abrazos y momentos inolvidables. Te desea lo mejor tu
        novio, <strong>José Luis</strong>, celebrando tu vida y todos nuestros años juntos.
      </Paragraph>
      <div class="hero-actions">
        <Button id="play-song-btn" variant="primary">
          🎵 Escuchar tonito de Feliz Cumpleaños
        </Button>
      </div>
    </section>

    <!-- Pastel Interactivo para Soplar las Velas -->
    <CakeStage />

    <!-- Detalles Interactivos de su Historia y Gustos -->
    <section>
      <Heading level={2} class="section-title" style="text-align:center; margin-bottom: 0.4rem;">
        Lo que Hace Único Nuestro Camino ✨
      </Heading>
      <Paragraph class="section-desc" style="text-align:center;">
        Toca cada tarjeta para descubrir un mensajito especial
      </Paragraph>

      <div class="moments-grid">
        <MomentCard
          icon="⛪"
          title="Dónde Empezó Todo"
          text="Nuestros caminos cruzándose en la Parroquia Apóstol Santiago, verte en los monaguillos y escucharte cantar con tanta alegría."
          secret="💫 Cada recuerdo desde aquel lugar sigue brillando como el primer día."
        />

        <MomentCard
          icon="🍽️"
          title="Sabores y Paseos"
          text="Salir a pasear juntos, conversar de todo y disfrutar de comidias ricas que te gustan."
          secret="💛 Hoy toca celebrar y consentirte con lo que más te gusta comer."
        />

        <MomentCard
          icon="🎮"
          title="Risas y Aventuras"
          text="Nuestras partidas llenas de risas jugando Minecraft y Roblox, construyendo mundos y pasando el mejor rato juntos."
          secret="💎 El mejor equipo en cada partida y en la vida real."
        />

        <MomentCard
          icon="💜"
          title="Tu Esencia Hermosa"
          text="Tan bella, bondadosa y pendiente de cuidarme siempre... incluso con ese toque poquito renegona que tanto me encanta de ti."
          secret="🌸 Te amo tal y como eres, mi cariño. ¡Gracias por tanto amor!"
        />
      </div>
    </section>

    <!-- Carta Dedicatoria Interactiva -->
    <LetterSection />

    <footer class="footer-note">Hecho con mucho cariño para mi Anahí 💙💜</footer>
  </main>
</Layout>
